# Infra
DATABASE_URL=postgres://gas:gas@localhost:5432/gas
REDIS_URL=redis://localhost:6379
PORT=3000
POSTGRES_PASSWORD=gas

# Sessão (cookie httpOnly gas_sessao). Em produção atrás do Caddy: COOKIE_SECURE=true e TRUST_PROXY=true.
SESSION_TTL=30d
COOKIE_SECURE=false
TRUST_PROXY=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# E-mail de convite (Resend). Sem RESEND_API_KEY, o link do convite vai para o log da API.
RESEND_API_KEY=
EMAIL_FROM=Gás Individualizado <no-reply@exemplo.com>
# URL pública do front, base dos links de convite.
APP_URL=http://localhost:3001

# Worker: intervalo da sincronização de leituras (ms).
SYNC_INTERVAL_MS=3600000

# --- Fonte simulada (enquanto a API da Aépio é caixa-preta) ---
# Instante "agora" da simulação; vazio = 2026-10-10T03:00Z, fixo para a demo ser reproduzível.
SIMULADA_ANCORA=
# Senha das contas criadas por `pnpm demo:seed`.
DEMO_SENHA=gas12345
# Front: mostra os botões de "entrar como" na tela de login. Lido no build do Next.
NEXT_PUBLIC_DEMO=false

# Testes de integração (pnpm test:integration cria e migra este banco).
TEST_DATABASE_URL=postgres://gas:gas@localhost:5432/gas_test
